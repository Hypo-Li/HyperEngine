<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

    <Type Name="hyp::HString">
        <DisplayString Condition="mId.index == 0xFFFF">None</DisplayString>

        <DisplayString Condition="mNumber == 0">
            {(char*)(hyp::HString::sPoolForNatvis->mStringBlocks[mId.index]._Mypair._Myval2->data._Elems + mId.offset + 2),sb}
        </DisplayString>

        <DisplayString Condition="mNumber != 0">
            {(char*)(hyp::HString::sPoolForNatvis->mStringBlocks[mId.index]._Mypair._Myval2->data._Elems + mId.offset + 2),sb}_{mNumber - 1}
        </DisplayString>

        <Expand>
            <Item Name="[Raw String]">
                (char*)(hyp::HString::sPoolForNatvis->mStringBlocks[mId.index]._Mypair._Myval2->data._Elems + mId.offset + 2),s
            </Item>
            <Item Name="Number">mNumber</Item>
            <Synthetic Name="[Memory Address]">
                <DisplayString>{(void*)(hyp::HString::sPoolForNatvis->mStringBlocks[mId.index]._Mypair._Myval2->data._Elems + mId.offset + 2)}</DisplayString>
            </Synthetic>
        </Expand>
    </Type>

</AutoVisualizer>
